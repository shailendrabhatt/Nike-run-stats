@page
@model Nike_DataExtraction.Pages.IndexModel

@{
    Layout = null; // Add your own layout if you want; or leave null for minimal setup
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Nike Run Data - Month by Month</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-light p-3">

    <h1 class="mb-4">Nike Runs - Month by Month</h1>

    <h2>Monthly Aggregates</h2>
    <table class="table table-bordered table-hover mb-4">
        <thead class="table-dark">
            <tr>
                <th>Month</th>
                <th>Session Count</th>
                <th>Total Distance (km)</th>
                <th>Total Calories</th>
                <th>Total Steps</th>
                <th>Avg Speed (km/h)</th>
                <th>Avg Pace (min/km)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var agg in Model.AggregatesPerMonth)
            {
                <tr>
                    <td>@agg.YearMonth</td>
                    <td>@agg.Count</td>
                    <td>@($"{agg.TotalDistance:F2}")</td>
                    <td>@($"{agg.TotalCalories:F2}")</td>
                    <td>@($"{agg.TotalSteps:F2}")</td>
                    <td>@($"{agg.AvgSpeed:F2}")</td>
                    <td>@($"{agg.AvgPace:F2}")</td>
                </tr>
            }
        </tbody>
    </table>

    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Monthly Distance & Calories</h5>
                </div>
                <div class="card-body">
                    <canvas id="monthlyChart" height="300"></canvas>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Monthly Performance Trends</h5>
                </div>
                <div class="card-body">
                    <canvas id="performanceChart" height="300"></canvas>
                </div>
            </div>
        </div>
    </div>

    <h2 class="mt-5">Runs Detail</h2>
    @foreach (var monthGroup in Model.RunsByMonth)
    {
        <h3>@monthGroup.Key</h3>
        <table class="table table-striped table-bordered mb-4">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Run ID</th>
                    <th>Speed (km/h)</th>
                    <th>Pace (min/km)</th>
                    <th>Steps</th>
                    <th>Calories</th>
                    <th>Distance (km)</th>
                    <th>Cadence</th>
                    <th>Location</th>
                    <th>Temperature (°C)</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var run in monthGroup)
            {
                <tr>
                    <td>@run.DateTimeDisplay</td>
                    <td>@run.Id</td>
                    <td>@($"{run.Speed:F2}")</td>
                    <td>@($"{run.Pace:F2}")</td>
                    <td>@($"{run.Steps:F2}")</td>
                    <td>@($"{run.Calories:F2}")</td>
                    <td>@($"{run.Distance:F2}")</td>
                    <td>@run.Cadence:F0</td>
                    <td>@run.Location</td>
                    <td>@run.Temperature</td>
                </tr>
            }
            </tbody>
        </table>
    }

    <script>
        // Prepare data for charts
        const months = @Html.Raw(Json.Serialize(Model.AggregatesPerMonth.Select(m => m.YearMonth)));
        const distances = @Html.Raw(Json.Serialize(Model.AggregatesPerMonth.Select(m => m.TotalDistance)));
        const calories = @Html.Raw(Json.Serialize(Model.AggregatesPerMonth.Select(m => m.TotalCalories)));
        const avgSpeeds = @Html.Raw(Json.Serialize(Model.AggregatesPerMonth.Select(m => m.AvgSpeed)));
        const avgPaces = @Html.Raw(Json.Serialize(Model.AggregatesPerMonth.Select(m => m.AvgPace)));
        const sessionCounts = @Html.Raw(Json.Serialize(Model.AggregatesPerMonth.Select(m => m.Count)));

        // First chart - Distance and Calories
        const ctx1 = document.getElementById('monthlyChart').getContext('2d');
        new Chart(ctx1, {
            type: 'bar',
            data: {
                labels: months,
                datasets: [
                    {
                        label: 'Total Distance (km)',
                        data: distances,
                        backgroundColor: 'rgba(54, 162, 235, 0.6)',
                        borderColor: 'rgba(54, 162, 235, 1)',
                        borderWidth: 1,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Total Calories',
                        data: calories,
                        backgroundColor: 'rgba(255, 99, 132, 0.6)',
                        borderColor: 'rgba(255, 99, 132, 1)',
                        borderWidth: 1,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Distance (km)'
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Calories'
                        },
                        grid: {
                            drawOnChartArea: false,
                        },
                    }
                },
                plugins: {
                    title: {
                        display: true,
                        text: 'Monthly Distance and Calories'
                    }
                }
            }
        });

        // Second chart - Performance metrics
        const ctx2 = document.getElementById('performanceChart').getContext('2d');
        new Chart(ctx2, {
            type: 'line',
            data: {
                labels: months,
                datasets: [
                    {
                        label: 'Average Speed (km/h)',
                        data: avgSpeeds,
                        borderColor: 'rgba(75, 192, 192, 1)',
                        backgroundColor: 'rgba(75, 192, 192, 0.2)',
                        borderWidth: 2,
                        fill: false,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Average Pace (min/km)',
                        data: avgPaces,
                        borderColor: 'rgba(255, 159, 64, 1)',
                        backgroundColor: 'rgba(255, 159, 64, 0.2)',
                        borderWidth: 2,
                        fill: false,
                        yAxisID: 'y1'
                    },
                    {
                        label: 'Session Count',
                        data: sessionCounts,
                        borderColor: 'rgba(153, 102, 255, 1)',
                        backgroundColor: 'rgba(153, 102, 255, 0.2)',
                        borderWidth: 2,
                        fill: false,
                        yAxisID: 'y2'
                    }
                ]
            },
            options: {
                responsive: true,
                interaction: {
                    mode: 'index',
                    intersect: false,
                },
                scales: {
                    y: {
                        type: 'linear',
                        display: true,
                        position: 'left',
                        title: {
                            display: true,
                            text: 'Speed (km/h)'
                        }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Pace (min/km)'
                        },
                        grid: {
                            drawOnChartArea: false,
                        },
                    },
                    y2: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        title: {
                            display: true,
                            text: 'Session Count'
                        },
                        grid: {
                            drawOnChartArea: false,
                        },
                    }
                },
                plugins: {
                    title: {
                        display: true,
                        text: 'Monthly Performance Trends'
                    }
                }
            }
        });
    </script>

</body>
</html>
